{
  "name": "instrace-core",
  "version": "0.1.1",
  "description": "Dependency-free library for resolving and comparing coding-agent instruction context.",
  "keywords": [
    "instrace",
    "ai",
    "coding-agent",
    "agent-context",
    "agents-md",
    "context",
    "devtools",
    "prompt-debugging",
    "mcp",
    "opencode",
    "codex",
    "claude-code"
  ],
  "license": "MIT",
  "author": "Amaan Syed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amaansyed27/instrace.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/amaansyed27/instrace#readme",
  "bugs": {
    "url": "https://github.com/amaansyed27/instrace/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.6.0"
  }
}
